# Whatomate — Coolify environment variables
# ---------------------------------------------------------------------------
# Copy these into Coolify's "Environment Variables" tab for the resource.
# Generate fresh secrets — do NOT reuse the placeholders below.
#   JWT secret / encryption key : openssl rand -hex 32
#   Postgres password           : openssl rand -hex 24
#
# The app maps env -> config with a WHATOMATE_ prefix and "__" between the
# section and the field:  WHATOMATE_DATABASE__HOST  ->  database.host
# ---------------------------------------------------------------------------

# ---- Public URL / CORS (REQUIRED in production) ----
# Must match the domain Coolify serves the app on (scheme included).
WHATOMATE_SERVER__ALLOWED_ORIGINS=https://whats.trtdigital.ma

# ---- Secrets (REQUIRED) ----
WHATOMATE_JWT__SECRET=replace-with-openssl-rand-hex-32   # must be >= 32 chars
WHATOMATE_APP__ENCRYPTION_KEY=replace-with-openssl-rand-hex-32   # >= 32 chars; encrypts WhatsApp tokens at rest

# ---- Database (REQUIRED) ----
# Option A — managed Postgres (Coolify/Heroku/etc.): paste the ONE connection URL.
# When DATABASE_URL is set it overrides the discrete WHATOMATE_DATABASE__* fields.
#   DATABASE_URL=postgres://user:pass@internal-host:5432/dbname?sslmode=require
#   (use the INTERNAL url; add ?sslmode=require only if the DB enforces TLS)
DATABASE_URL=

# Option B — bundled postgres service (default): leave DATABASE_URL empty and set:
POSTGRES_USER=whatomate
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24
POSTGRES_DB=whatomate

# ---- Redis (choose one, mirrors the DB options) ----
# Managed Redis: REDIS_URL=redis://:password@internal-host:6379/0
#   - Internal Coolify Redis is plaintext -> use redis:// (no TLS).
#   - Only use rediss:// if the server actually requires TLS. For a self-signed /
#     private-CA cert add ?tls_skip_verify=true, e.g.
#       rediss://:password@internal-host:6379/0?tls_skip_verify=true
# Bundled redis service (default): leave REDIS_URL empty.
REDIS_URL=

# ---- Initial admin (used ONLY on first boot when no users exist) ----
WHATOMATE_DEFAULT_ADMIN__EMAIL=admin@trtdigital.ma
WHATOMATE_DEFAULT_ADMIN__PASSWORD=replace-with-a-strong-password
WHATOMATE_DEFAULT_ADMIN__FULL_NAME=Admin

# ---- WhatsApp Cloud API (OPTIONAL — fill when connecting Meta) ----
WHATOMATE_WHATSAPP__APP_ID=
WHATOMATE_WHATSAPP__APP_SECRET=
WHATOMATE_WHATSAPP__CONFIG_ID=
WHATOMATE_WHATSAPP__WEBHOOK_VERIFY_TOKEN=

# ---- Meta offline conversions (free Conversions API) — TRT patch #35 ----
# Sends a "Purchase" event to Meta when a client is tagged Converted, so ads
# can attribute the sale to the Click-to-WhatsApp ad. Everything is configured
# PER SPACE in the app's account settings (enable, dataset id, access token,
# test code, value, currency). The ACCESS_TOKEN below is only an OPTIONAL GLOBAL
# FALLBACK used when a space has no token of its own — a secret, so if you set
# it, put it in Coolify's secret vars. Leave empty to require a per-space token.
WHATOMATE_META__ACCESS_TOKEN=
WHATOMATE_META__EVENT_NAME=Purchase
WHATOMATE_META__CURRENCY=MAD
WHATOMATE_META__DEFAULT_VALUE=0

# ---- Coolify domain binding (leave empty; Coolify fills it) ----
# Presence of this var tells Coolify to route the assigned domain to port 8080.
SERVICE_FQDN_WHATOMATE_8080=
